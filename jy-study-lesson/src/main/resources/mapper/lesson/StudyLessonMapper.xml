<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jy.study.lesson.mapper.StudyLessonMapper">
    <resultMap type="StudyLesson" id="LessonResult">
        <id     property="lessonId"     column="lesson_id"     />
        <result property="title"        column="title"         />
        <result property="coverImg"     column="cover_img"     />
        <result property="description"  column="description"   />
        <result property="category"     column="category"      />
        <result property="tags"         column="tags"          />
        <result property="teacherId"    column="teacher_id"    />
        <result property="price"        column="price"         />
        <result property="status"       column="status"        />
        <result property="sort"         column="sort"          />
        <result property="viewCount"    column="view_count"    />
        <result property="buyCount"     column="buy_count"     />
        <result property="likeCount"    column="like_count"    />
        <result property="collectCount" column="collect_count" />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectStudyLessonVo"> select lesson_id, title, cover_img, description, category, tags, teacher_id, price, status, sort, view_count, buy_count, like_count, collect_count, create_by, create_time, update_by, update_time, remark from study_lesson </sql>

    <!-- 计数相关SQL -->
    <update id="incrementViewCount">
        update study_lesson set view_count = view_count + 1 where lesson_id = #{lessonId}
    </update>

    <update id="incrementLikeCount">
        update study_lesson set like_count = like_count + 1 where lesson_id = #{lessonId}
    </update>

    <update id="decrementLikeCount">
        update study_lesson set like_count = like_count - 1 where lesson_id = #{lessonId}
    </update>

    <update id="incrementCollectCount">
        update study_lesson set collect_count = collect_count + 1 where lesson_id = #{lessonId}
    </update>

    <update id="decrementCollectCount">
        update study_lesson set collect_count = collect_count - 1 where lesson_id = #{lessonId}
    </update>


    <select id="selectLessonList" parameterType="StudyLesson" resultMap="LessonResult">
        select * from study_lesson
        <where>
            <if test="title != null and title != ''">
                AND title like concat('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="teacherId != null">
                AND teacher_id = #{teacherId}
            </if>
        </where>
        order by sort
    </select>

    <!-- 其他增删改查SQL -->
    <select id="selectStudyLessonList" parameterType="StudyLesson" resultMap="LessonResult">
        <include refid="selectStudyLessonVo"/>
        <where>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="coverImg != null  and coverImg != ''"> and cover_img = #{coverImg}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="tags != null  and tags != ''"> and tags = #{tags}</if>
            <if test="teacherId != null "> and teacher_id = #{teacherId}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="viewCount != null "> and view_count = #{viewCount}</if>
            <if test="buyCount != null "> and buy_count = #{buyCount}</if>
            <if test="likeCount != null "> and like_count = #{likeCount}</if>
            <if test="collectCount != null "> and collect_count = #{collectCount}</if>
        </where>
    </select>

    <select id="selectStudyLessonByLessonId" parameterType="Long" resultMap="LessonResult">
        <include refid="selectStudyLessonVo"/>
        where lesson_id = #{lessonId}
    </select>

    <insert id="insertStudyLesson" parameterType="StudyLesson" useGeneratedKeys="true" keyProperty="lessonId">
        insert into study_lesson
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="coverImg != null">cover_img,</if>
            <if test="description != null">description,</if>
            <if test="category != null">category,</if>
            <if test="tags != null">tags,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="price != null">price,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="buyCount != null">buy_count,</if>
            <if test="likeCount != null">like_count,</if>
            <if test="collectCount != null">collect_count,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="coverImg != null">#{coverImg},</if>
            <if test="description != null">#{description},</if>
            <if test="category != null">#{category},</if>
            <if test="tags != null">#{tags},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="price != null">#{price},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="buyCount != null">#{buyCount},</if>
            <if test="likeCount != null">#{likeCount},</if>
            <if test="collectCount != null">#{collectCount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateStudyLesson" parameterType="StudyLesson">
        update study_lesson
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="coverImg != null">cover_img = #{coverImg},</if>
            <if test="description != null">description = #{description},</if>
            <if test="category != null">category = #{category},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="buyCount != null">buy_count = #{buyCount},</if>
            <if test="likeCount != null">like_count = #{likeCount},</if>
            <if test="collectCount != null">collect_count = #{collectCount},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where lesson_id = #{lessonId}
    </update>

    <delete id="deleteStudyLessonByLessonId" parameterType="Long">
        delete from study_lesson where lesson_id = #{lessonId}
    </delete>

    <delete id="deleteStudyLessonByLessonIds" parameterType="String">
        delete from study_lesson where lesson_id in
        <foreach item="lessonId" collection="array" open="(" separator="," close=")">
            #{lessonId}
        </foreach>
    </delete>

</mapper>
