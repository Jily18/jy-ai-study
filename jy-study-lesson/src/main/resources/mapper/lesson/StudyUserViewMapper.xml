<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jy.study.lesson.mapper.StudyUserViewMapper">

    <resultMap type="StudyUserView" id="UserViewResult">
        <id     property="viewId"      column="view_id"      />
        <result property="userId"      column="user_id"      />
        <result property="type"        column="type"         />
        <result property="targetId"    column="target_id"    />
        <result property="ipAddr"      column="ip_addr"      />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <insert id="insertUserView" parameterType="StudyUserView">
        insert into study_user_view (
            user_id,
            type,
            target_id,
            ip_addr,
            create_time
        ) values (
            #{userId},
            #{type},
            #{targetId},
            #{ipAddr},
            #{createTime}
        )
    </insert>

    <select id="selectUserView" resultMap="UserViewResult">
        select * from study_user_view
        where user_id = #{param1} and type = #{param2} and target_id = #{param3}
        limit 1
    </select>

    <delete id="deleteUserView" parameterType="Long">
        delete from study_user_view where view_id = #{viewId}
    </delete>

</mapper> 